# Copy to .env and fill in. Never commit .env.
DATABASE_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/frenchaesthetic?retryWrites=true&w=majority"
PAYLOAD_SECRET="<long random string>"

# Public address of this deployment (canonical URLs, Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# "staging" (default): kept out of search engines, unconfirmed facts shown with a CONFIRM marker.
# Set to "production" only on launch day; unconfirmed facts are then hidden.
SITE_STAGE="staging"

# Media storage. Without these three, uploads go to ./media (fine on a laptop, lost on a Hostinger redeploy).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="french-aesthetic"

# Outgoing email for enrollment alerts (e.g. the Hostinger mailbox: smtp.hostinger.com, port 465).
# Without SMTP_HOST, emails are written to the server log instead. Recipients are set in
# Site settings → Academy → Enrollment alert emails.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

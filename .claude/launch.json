{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "website-production",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "SITE_STAGE=production",
        "npm",
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "website-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    }
  ]
}

{
  "name": "french-aesthetic",
  "version": "0.1.0",
  "private": true,
  "description": "Website for French Medical Aesthetics (clinic) and French Aesthetics Academy",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=3072\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/email-nodemailer": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-cloud-storage": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cloudinary": "^2.5.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.63.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "5.7.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "overrides": {
    "happy-dom": "21.0.4"
  }
}
